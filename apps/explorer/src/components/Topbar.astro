---
import Button from "./Button.astro";
import SettingsDropdown from "./live/SettingsDropdown";

interface Props {
  active?: "overview" | "blocks" | "messages" | "programs" | "codes" | "decode" | "settings" | "compare";
}

const { active = "overview" } = Astro.props;
const nav = [
  { id: "overview", href: "/", label: "HOME" },
  { id: "blocks", href: "/blocks", label: "BLOCKS" },
  { id: "messages", href: "/messages", label: "MESSAGES" },
  { id: "programs", href: "/programs", label: "PROGRAMS" },
  { id: "codes", href: "/codes", label: "CODES" },
  { id: "decode", href: "/decode", label: "DECODE" }
] as const;
---

<header class="topbar">
  <div class="topbar-inner">
    <a class="logo" href="/" aria-label="Vara Sails Explorer home">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-copy">Vara Sails Explorer<small>Blocks · messages · programs</small></span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[active === item.id && "active"]}
            aria-current={active === item.id ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-search" role="search">
      <input aria-label="Global explorer search" placeholder="Search block, msg, program, code, account..." />
      <span class="kbd-hint" aria-hidden="true">/</span>
    </div>
    <div class="header-actions">
      <SettingsDropdown client:load />
      <Button variant="primary">CONNECT WALLET</Button>
    </div>
  </div>
</header>
