---
interface Props {
  state: "loading" | "empty" | "error";
  title: string;
  description: string;
}

const { state, title, description } = Astro.props;
---

<section class:list={["state-panel", state]}>
  <div class="state-mark" aria-hidden="true">
    {
      state === "loading" ? (
        <span class="state-bars"><span></span><span></span><span></span></span>
      ) : state === "empty" ? (
        <svg viewBox="0 0 24 24"><path d="M4.5 7.5h15v10h-15zM7 10h10M7 13.5h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      ) : (
        <svg viewBox="0 0 24 24"><path d="M12 5.5v7M12 16.5h.01M4.8 19h14.4L12 4.8 4.8 19z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      )
    }
  </div>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
    {state === "loading" && (
      <div class="skeleton-stack" aria-label="Loading preview">
        <span class="skeleton-line wide"></span>
        <span class="skeleton-line"></span>
      </div>
    )}
  </div>
</section>
