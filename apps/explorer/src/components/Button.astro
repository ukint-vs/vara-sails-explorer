---
interface Props {
  href?: string;
  variant?: "default" | "primary" | "ghost";
  size?: "sm" | "md";
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
  dataCopy?: string;
}

const {
  href,
  variant = "default",
  size = "md",
  type = "button",
  ariaLabel,
  dataCopy
} = Astro.props;
const classes = ["btn", variant, size === "sm" && "small"];
---

{
  href ? (
    <a class:list={classes} href={href} aria-label={ariaLabel} data-copy={dataCopy}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type} aria-label={ariaLabel} data-copy={dataCopy}>
      <slot />
    </button>
  )
}
