---
import type { ExplorerMessage } from "../data/types";
import Chip from "./Chip.astro";
import CopyHash from "./CopyHash.astro";
import StatusChip from "./StatusChip.astro";

interface Props {
  messages: ExplorerMessage[];
  compact?: boolean;
}

const { messages, compact = false } = Astro.props;
---

<div class:list={["table", "messages", compact && "compact"]}>
  <div class="table-head">
    <span>Message</span>
    <span>Age</span>
    <span>Kind</span>
    <span>Program</span>
    <span>Activity</span>
    <span>Execution</span>
    <span>Decode</span>
    <span>Finality</span>
    <span>Block / fee</span>
  </div>
  {
    messages.map((message) => (
      <div class="table-row" data-searchable>
        <div class="cell-stack">
          <CopyHash value={message.id} label={message.id} href="/message-detail" name="message ID" />
          <span class="cell-sub mono">{message.caller}</span>
        </div>
        <div class="cell-stack">
          <span class="cell-main mono">{message.age}</span>
          <span class="cell-sub mono">{message.time}</span>
        </div>
        <div><Chip label={message.kind} compact /></div>
        <div class="cell-stack">
          <span class="cell-main">{message.program}</span>
          <CopyHash value={message.programId} label={message.programId} name="program ID" />
        </div>
        <div class="cell-stack">
          <span class="cell-main">{message.activity}</span>
          <span class="cell-sub">{message.result}</span>
        </div>
        <div><StatusChip kind="execution" value={message.execution} compact /></div>
        <div><StatusChip kind="decode" value={message.decode} compact /></div>
        <div><StatusChip kind="finality" value={message.finality} compact /></div>
        <div class="cell-stack">
          <span class="cell-main mono">{message.block}</span>
          <span class="cell-sub">{message.fee}</span>
        </div>
      </div>
    ))
  }
</div>
