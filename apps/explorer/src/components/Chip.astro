---
import type { ChipTone } from "../data/types";

interface Props {
  tone?: ChipTone;
  label?: string;
  dot?: boolean;
  compact?: boolean;
}

const { tone = "neutral", label, dot = false, compact = false } = Astro.props;
---

<span class:list={["chip", tone, compact && "compact"]}>
  {dot && <span class="dot" aria-hidden="true"></span>}
  {label ? <span class="chip-label">{label}</span> : <slot />}
</span>
