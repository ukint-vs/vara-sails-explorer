---
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Chip from "../components/Chip.astro";
import CopyHash from "../components/CopyHash.astro";
import NetStats from "../components/NetStats.astro";
import StatusChip from "../components/StatusChip.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { messages } from "../data/fixtures";

const message = messages[0];
---

<BaseLayout title="Message detail" active="messages" showStatus={false}>
  <main id="main-content" class="layout layout-dense">
    <NetStats compact />

    <section class="page-head compact-head">
      <div>
        <div class="eyebrow">Message</div>
        <h1>{message.id}</h1>
        <p class="lede">Execution, finality, decode status, payload bytes, caller, fee, and trust evidence for one Gear message.</p>
      </div>
      <div class="chip-row">
        <StatusChip kind="execution" value={message.execution} />
        <StatusChip kind="decode" value={message.decode} />
        <StatusChip kind="finality" value={message.finality} />
      </div>
    </section>

    <section class="object-actions" aria-label="Message actions">
      <CopyHash value={message.id} label="Message ID" name="message ID" />
      <Button dataCopy={message.payload} size="sm">Copy payload</Button>
      <Button href="/decode" size="sm">Open in decode</Button>
      <Button size="sm">Watch finality</Button>
      <Button size="sm">View JSON</Button>
    </section>

    <nav class="object-tabs" aria-label="Message sections">
      <a class="tab active" href="#overview">Overview</a>
      <a class="tab" href="#lifecycle">Lifecycle</a>
      <a class="tab" href="#decoded">Decoded</a>
      <a class="tab" href="#raw">Raw</a>
      <a class="tab" href="#trust">Trust</a>
    </nav>

    <section class="grid wide-sidebar section-offset" id="overview">
      <div class="stack">
        <div class="card hero-summary">
          <div class="summary-line">
            <span class="muted-word">{message.caller}</span> called <span class="mono">OrderBook.place_limit_order</span>
            in <span class="mono">{message.block}</span>; result is <span class="mono">{message.result}</span>.
          </div>
          <div class="chip-row">
            <StatusChip kind="execution" value={message.execution} prefix="Execution" />
            <StatusChip kind="decode" value={message.decode} prefix="Decode" />
            <StatusChip kind="finality" value={message.finality} prefix="Finality" />
            <StatusChip kind="dataSource" value={message.dataSource} prefix="Source" />
            <StatusChip kind="trust" value={message.trust} prefix="IDL" />
          </div>
        </div>

        <Card title="Lifecycle" description="Protocol state, decode state, and finality are tracked independently." id="lifecycle">
          <div class="timeline">
            <div class="step done"><span class="step-marker">1</span><div><div class="step-title">Submitted</div><div class="step-copy">Extrinsic accepted by the selected Vara RPC endpoint.</div></div><span class="step-time">14:08:55</span></div>
            <div class="step done"><span class="step-marker">2</span><div><div class="step-title">Included</div><div class="step-copy">Message observed in block {message.block}.</div></div><span class="step-time">+1.2s</span></div>
            <div class="step done"><span class="step-marker">3</span><div><div class="step-title">Executed</div><div class="step-copy">Program returned OrderAccepted and one partial fill.</div></div><span class="step-time">+1.4s</span></div>
            <div class="step current"><span class="step-marker">4</span><div><div class="step-title">Pre-confirmed</div><div class="step-copy">Signed result available; waiting for finalized block confirmation.</div></div><span class="step-time">now</span></div>
            <div class="step"><span class="step-marker">5</span><div><div class="step-title">Finalized</div><div class="step-copy">Expected after finalized head passes the message block.</div></div><span class="step-time">pending</span></div>
          </div>
        </Card>

        <Card title="Decoded call" description="Sails IDL maps the payload to service, method, arguments, reply, and event names." id="decoded">
          <Fragment slot="action"><Button size="sm" dataCopy="OrderBook.place_limit_order({ side: 'Buy', price: 1850, quantity: 2.4 })">Copy call</Button></Fragment>
          <pre class="code-block"><span class="comment">// service: OrderBook · route_idx: 1 · entry_id: 7</span>
&#123;
  <span class="key">"kind"</span>: <span class="str">"{message.kind}"</span>,
  <span class="key">"method"</span>: <span class="str">"place_limit_order"</span>,
  <span class="key">"args"</span>: &#123;
    <span class="key">"side"</span>: <span class="str">"Buy"</span>,
    <span class="key">"price"</span>: <span class="num">1850_000000</span>,
    <span class="key">"quantity"</span>: <span class="num">2400000000000000000</span>,
    <span class="key">"time_in_force"</span>: <span class="str">"GTC"</span>
  &#125;,
  <span class="key">"result"</span>: <span class="str">"{message.result}"</span>
&#125;</pre>
        </Card>

        <Card title="Header and bytes" description="Header fields, route identifiers, raw payload, and codec." id="raw">
          <div class="byte-grid">
            <div class="byte-line"><strong>magic</strong><span class="bytes">53 41 49 4c · version 01 · header_len 10</span><span>valid</span></div>
            <div class="byte-line"><strong>entry</strong><span class="bytes">interface_id 0x8b7d9c11 · entry_id 07</span><span>place_limit_order</span></div>
            <div class="byte-line"><strong>route</strong><span class="bytes">route_idx 01 · reserved 00</span><span>OrderBook</span></div>
            <div class="byte-line"><strong>payload</strong><span class="bytes">{message.payload}</span><span>SCALE</span></div>
          </div>
        </Card>
      </div>

      <aside class="stack">
        <Card pad body={false} className="stack">
          <h3>Identifiers</h3>
          <dl>
            <div class="kv"><dt>Message ID</dt><dd><CopyHash value={message.id} label={message.id} name="message ID" /></dd></div>
            <div class="kv"><dt>Program</dt><dd>{message.program}</dd></div>
            <div class="kv"><dt>Program ID</dt><dd><CopyHash value={message.programId} label={message.programId} name="program ID" /></dd></div>
            <div class="kv"><dt>Code ID</dt><dd><CopyHash value={message.codeId} label={message.codeId} name="code ID" /></dd></div>
            <div class="kv"><dt>Block</dt><dd><a class="hash" href="/blocks">{message.block}</a></dd></div>
            <div class="kv"><dt>Caller</dt><dd><CopyHash value={message.caller} label={message.caller} name="caller" /></dd></div>
            <div class="kv"><dt>Fee</dt><dd>{message.fee}</dd></div>
          </dl>
        </Card>
        <Card pad body={false} className="stack" id="trust">
          <h3>Trust checks</h3>
          <div class="doc-list">
            <div class="doc-item"><span class="doc-icon">1</span><div><div class="doc-title">Header valid</div><div class="doc-copy">Magic, version, length, and reserved byte passed.</div></div></div>
            <div class="doc-item"><span class="doc-icon">2</span><div><div class="doc-title">IDL source</div><div class="doc-copy"><StatusChip kind="trust" value={message.trust} compact /> decoded this payload.</div></div></div>
            <div class="doc-item"><span class="doc-icon">3</span><div><div class="doc-title">Finality pending</div><div class="doc-copy">Execution remains provisional until finalized head reaches the message block.</div></div></div>
          </div>
        </Card>
        <Card pad body={false} className="stack">
          <h3>Related queries</h3>
          <Button href="/messages">Same program messages</Button>
          <Button href="/program-detail">Open program</Button>
          <Button href="/codes">Open code ID</Button>
          <Chip tone="info" label="Direct RPC + cache" />
        </Card>
      </aside>
    </section>
  </main>
</BaseLayout>
