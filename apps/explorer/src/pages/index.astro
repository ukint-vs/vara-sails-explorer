---
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import DataCard from "../components/DataCard.astro";
import ExplorerSearch from "../components/ExplorerSearch.astro";
import LiveNetStats from "../components/live/LiveNetStats";
import LiveOverviewBlocksPanel from "../components/live/LiveOverviewBlocksPanel";
import MessageTable from "../components/MessageTable.astro";
import Pagination from "../components/Pagination.astro";
import ProgramTable from "../components/ProgramTable.astro";
import SparkBars from "../components/SparkBars.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blocks, codeSummaries, messages, netStats, programs, topEvents } from "../data/fixtures";
---

<BaseLayout title="Overview" active="overview" showStatus={false}>
  <main id="main-content" class="layout layout-dense">
    <LiveNetStats initialBlocks={blocks} initialStats={netStats} client:load />

    <section class="page-head compact-head">
      <div>
        <div class="eyebrow">Workspace</div>
        <h1>Live Vara activity.</h1>
        <p class="lede">
          Search blocks, messages, programs, code IDs, accounts, events, and raw bytes against the connected endpoint and local cache.
        </p>
      </div>
      <div class="chip-row">
        <Chip tone="info" label="RPC stream" dot />
        <Chip tone="success" label="IndexedDB cache" dot />
        <Chip tone="steel" label="Preview routes" dot />
      </div>
    </section>

    <ExplorerSearch />

    <section class="hero-row section-offset" aria-label="Latest chain activity">
      <DataCard title="Latest blocks" description="Best and finalized heads with hash, age, Gear message volume, and failure count.">
        <Fragment slot="action"><Button href="/blocks" size="sm">Open blocks</Button></Fragment>
        <LiveOverviewBlocksPanel initialBlocks={blocks.slice(0, 8)} client:load />
        <Fragment slot="foot"><Pagination label="Block rows" location="Last 6 cached blocks" placeholder="Block #" /></Fragment>
      </DataCard>

      <DataCard title="Latest messages preview" description="Fixture rows for the Milestone 2 message stream; live M1 data starts from observed blocks.">
        <Fragment slot="action"><Button href="/messages" size="sm">Open messages</Button></Fragment>
        <MessageTable messages={messages} compact />
        <Fragment slot="foot"><Pagination label="Message rows" location="Last 7 cached messages" placeholder="Message / block" /></Fragment>
      </DataCard>
    </section>

    <section class="activity-grid section-offset" aria-label="Explorer summaries">
      <DataCard title="Program preview" description="Static program rows until observed program objects are promoted from live RPC data.">
        <ProgramTable programs={programs} compact />
      </DataCard>

      <DataCard title="Top events" description="Event names observed in the current block window.">
        <div class="mini-list">
          {
            topEvents.map((event) => (
              <div class="mini-row og" data-searchable>
                <div class="cell-stack">
                  <span class="cell-main">{event.name}</span>
                  <span class="cell-sub">{event.program}</span>
                </div>
                <SparkBars values={event.trend} />
                <span class="cell-main mono">{event.count}</span>
              </div>
            ))
          }
        </div>
      </DataCard>

      <DataCard title="Observed program preview" description="Program IDs shown here are fixture examples until live object extraction backs this panel.">
        <div class="mini-list">
          {
            programs.slice(0, 4).map((program) => (
              <a class="mini-row og" href="/program-detail" data-searchable>
                <div class="cell-stack">
                  <span class="cell-main">{program.name}</span>
                  <span class="cell-sub mono">{program.programId}</span>
                </div>
                <span class="cell-sub mono">{program.deployedAt}</span>
                <span class="cell-main mono">{program.messages24h}</span>
              </a>
            ))
          }
        </div>
      </DataCard>

      <DataCard title="Code and IDL preview" description="Fixture code rows for the later registry/decode milestones.">
        <div class="mini-list">
          {
            codeSummaries.map((code) => (
              <a class="mini-row og" href="/codes" data-searchable>
                <div class="cell-stack">
                  <span class="cell-main mono">{code.codeId}</span>
                  <span class="cell-sub">{code.idlStatus}</span>
                </div>
                <span class="cell-sub">{code.size}</span>
                <span class="cell-main">{code.programs}</span>
              </a>
            ))
          }
        </div>
      </DataCard>
    </section>
  </main>
</BaseLayout>
