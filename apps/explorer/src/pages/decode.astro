---
import Chip from "../components/Chip.astro";
import { DecodeLab } from "../components/decode/DecodeLab";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Decode lab" active="decode">
  <main id="main-content" class="layout decode-layout">
    <section class="page-head decode-head">
      <div>
        <div class="eyebrow">Decode lab</div>
        <h1>Sails payload workbench.</h1>
      </div>
      <div class="chip-row">
        <Chip tone="success" label="Worker decode" />
        <Chip tone="info" label="IDL provenance" />
      </div>
      <p class="decode-trust-line">
        Decoded values are untrusted until tied to a verified code ID, verified IDL, and finalized chain data.
      </p>
    </section>

    <DecodeLab client:only="react" />
  </main>
</BaseLayout>
