---
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import DataCard from "../components/DataCard.astro";
import MessageTable from "../components/MessageTable.astro";
import NetStats from "../components/NetStats.astro";
import Pagination from "../components/Pagination.astro";
import StatePanel from "../components/StatePanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { messages } from "../data/fixtures";
---

<BaseLayout title="Messages" active="messages" showStatus={false}>
  <main id="main-content" class="layout layout-dense">
    <NetStats compact />

    <section class="page-head compact-head">
      <div>
        <div class="eyebrow">Messages</div>
        <h1>Message stream preview.</h1>
        <p class="lede">Fixture rows model the Milestone 2 message stream. M1 only promotes message objects observed from live block data.</p>
      </div>
      <div class="chip-row">
        <Chip tone="info" label="Preview · M2" dot />
        <Chip tone="steel" label="Fixture rows" dot />
      </div>
    </section>

    <section class="filter-bar" aria-label="Message filters">
      <input class="input" data-local-filter aria-label="Filter local messages" placeholder="Filter message, program, caller, status, block..." />
      <select class="select" aria-label="Execution filter">
        <option>All execution states</option>
        <option>Executed</option>
        <option>Replied</option>
        <option>Failed</option>
        <option>Included</option>
      </select>
      <select class="select" aria-label="Decode filter">
        <option>All decode states</option>
        <option>Decoded</option>
        <option>Missing IDL</option>
        <option>Trailing bytes</option>
      </select>
      <Button href="/decode" size="sm">Decode raw bytes</Button>
    </section>

    <DataCard title="Message cache preview" description="Static examples for the later live message cache. Full historical account/message search belongs to indexed mode.">
      <MessageTable messages={messages} />
      <Fragment slot="foot"><Pagination label="Message pagination" location="Showing latest cached messages" placeholder="Jump to message / block" /></Fragment>
    </DataCard>

    <section class="state-grid" aria-label="Message stream states">
      <StatePanel state="loading" title="RPC stream connecting" description="Skeleton rows preserve the table shape while the message stream opens." />
      <StatePanel state="empty" title="No local messages match the filter" description="Clear the filter or wait for the local cache window to capture new Gear messages." />
      <StatePanel state="error" title="RPC stream interrupted" description="Keep cached rows visible and show the endpoint error inline instead of replacing the whole page." />
    </section>
  </main>
</BaseLayout>
