---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Settings" active="settings" showStatus={false}>
  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    params.set("settings", "open");
    const query = params.toString();
    window.location.replace(query ? `/?${query}` : "/");
  </script>

  <main id="main-content" class="layout layout-dense">
    <section class="page-head compact-head">
      <div>
        <div class="eyebrow">Settings</div>
        <h1>Explorer settings.</h1>
      </div>
    </section>
  </main>
</BaseLayout>
