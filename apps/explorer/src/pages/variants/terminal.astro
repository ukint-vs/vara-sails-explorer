---
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import Chip from "../../components/Chip.astro";
import MessageTable from "../../components/MessageTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { messages } from "../../data/fixtures";
---

<BaseLayout title="Terminal variant" active="compare" variant="terminal">
  <main id="main-content" class="layout">
    <section class="page-head">
      <div>
        <div class="eyebrow">Design comp A</div>
        <h1>Raw message and header debugging layout.</h1>
        <p class="lede">Prioritizes message IDs, route IDs, bytes, and decode flags for protocol-heavy sessions.</p>
      </div>
      <div class="chip-row"><Chip tone="brand" label="Raw" /><Chip tone="info" label="Precise" /></div>
    </section>

    <section class="grid sidebar">
      <Card title="Message tail" description="Dense rows, minimal prose, maximum identifiers.">
        <MessageTable messages={messages} compact />
      </Card>
      <aside class="stack">
        <Card title="Header sample">
          <pre class="code-block">magic      53 41 49 4c
version    01
hlen       10
iface      0x8b7d9c11
entry      07
route      01
reserved   00</pre>
        </Card>
        <Button href="/compare">Back to comparison</Button>
      </aside>
    </section>
  </main>
</BaseLayout>
