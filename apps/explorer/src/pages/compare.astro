---
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Chip from "../components/Chip.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { variants } from "../data/fixtures";
---

<BaseLayout title="Variant comparison" active="compare">
  <main id="main-content" class="layout">
    <section class="page-head">
      <div>
        <div class="eyebrow">Design comparison</div>
        <h1>Compare alternate explorer layouts against daily-use tasks.</h1>
        <p class="lede">
          These routes are reference comps for density, explanation, and lookup flows. The main explorer should stay
          focused on blocks, messages, programs, accounts, decode, and network status.
        </p>
      </div>
      <Chip tone="brand" label="Comparison only" />
    </section>

    <section class="variant-grid">
      {
        variants.map((variant) => (
          <Card title={variant.name} description={variant.caption} className={`variant-card compare-${variant.slug}`}>
            <Fragment slot="action"><Button href={variant.route} size="sm">Open comp</Button></Fragment>
            <div class="variant-preview">
              <div class="chip-row"><Chip tone="info" label={variant.role} /><Chip label={variant.slug} /></div>
              <div class="mini-row"><span class="hash">14:08:56</span><span>{variant.caption}</span><Chip tone="brand" label="Decoded" compact /></div>
              <div class="mini-row"><span class="hash">#18,427,057</span><span>Direct RPC · local cache window</span><Chip tone="success" label="Healthy" compact /></div>
            </div>
          </Card>
        ))
      }
    </section>
  </main>
</BaseLayout>
