---
import BlockDetailPanel from "../components/live/BlockDetailPanel";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Block detail" active="blocks" showStatus={false}>
  <main id="main-content" class="layout layout-dense">
    <section class="page-head compact-head">
      <div>
        <div class="eyebrow">Block detail</div>
        <h1>Block detail.</h1>
        <p class="lede">Open a block by number or hash and inspect observed Gear objects, events, and extrinsics returned by the selected endpoint or cache.</p>
      </div>
    </section>

    <BlockDetailPanel client:load />
  </main>
</BaseLayout>
