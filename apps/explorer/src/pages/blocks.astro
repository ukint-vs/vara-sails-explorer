---
import Chip from "../components/Chip.astro";
import LiveBlocksPanel from "../components/live/LiveBlocksPanel";
import LiveNetStats from "../components/live/LiveNetStats";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blocks, netStats } from "../data/fixtures";
---

<BaseLayout title="Blocks" active="blocks" showStatus={false}>
  <main id="main-content" class="layout layout-dense">
    <LiveNetStats initialBlocks={blocks} initialStats={netStats} compact client:load />

    <section class="page-head compact-head">
      <div>
        <div class="eyebrow">Blocks</div>
        <h1>Recent blocks with finality, authors, Gear messages, and Sails decode counts.</h1>
        <p class="lede">Use this view to compare best and finalized heads, spot failed messages, and jump to a block from the cache window.</p>
      </div>
      <div class="chip-row">
        <Chip tone="info" label="Best block" dot />
        <Chip tone="success" label="Finalized" dot />
      </div>
    </section>

    <LiveBlocksPanel initialBlocks={blocks} client:load />
  </main>
</BaseLayout>
